# Copy this file to .env and adjust if needed. .env is git-ignored - never commit real secrets.

POSTGRES_DB=taskapi
POSTGRES_USER=taskapi
POSTGRES_PASSWORD=changeme

# Used by the api container (Phase 9) and by application.properties's dev fallback.
# Generate a real one with: openssl rand -base64 32
JWT_SECRET=please-change-this-to-a-random-32-byte-value-minimum
